    Writeln('PASS: Pauth HLE output/size, error handling and no unauthenticated plaintext');
  finally
    Service.Free; S.Free; H.Free; C.Free; M.Free;
  end;
end;

begin
  try
    Primitives;
    Envelopes;
    GuestService;
  except
    on E: Exception do
    begin
      Writeln(E.ClassName + ': ' + E.Message);
      ExitCode := 1;
    end;
  end;
end.
