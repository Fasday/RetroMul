<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{D1D610E6-27EB-415C-851B-6ACE1A335D30}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="apps\retromul\RetroMul.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="apps\terminal\RetromulTerm.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="dependencies\FMXInput\examples\FMXDemo\FMXInputDemo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="apps\retrotune\RetroTune.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RetroMul">
        <MSBuild Projects="apps\retromul\RetroMul.dproj"/>
    </Target>
    <Target Name="RetroMul:Clean">
        <MSBuild Projects="apps\retromul\RetroMul.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetroMul:Make">
        <MSBuild Projects="apps\retromul\RetroMul.dproj" Targets="Make"/>
    </Target>
    <Target Name="RetromulTerm">
        <MSBuild Projects="apps\terminal\RetromulTerm.dproj"/>
    </Target>
    <Target Name="RetromulTerm:Clean">
        <MSBuild Projects="apps\terminal\RetromulTerm.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetromulTerm:Make">
        <MSBuild Projects="apps\terminal\RetromulTerm.dproj" Targets="Make"/>
    </Target>
    <Target Name="FMXInputDemo">
        <MSBuild Projects="dependencies\FMXInput\examples\FMXDemo\FMXInputDemo.dproj"/>
    </Target>
    <Target Name="FMXInputDemo:Clean">
        <MSBuild Projects="dependencies\FMXInput\examples\FMXDemo\FMXInputDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMXInputDemo:Make">
        <MSBuild Projects="dependencies\FMXInput\examples\FMXDemo\FMXInputDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="RetroTune">
        <MSBuild Projects="apps\retrotune\RetroTune.dproj"/>
    </Target>
    <Target Name="RetroTune:Clean">
        <MSBuild Projects="apps\retrotune\RetroTune.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetroTune:Make">
        <MSBuild Projects="apps\retrotune\RetroTune.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="RetroMul;RetromulTerm;FMXInputDemo;RetroTune"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="RetroMul:Clean;RetromulTerm:Clean;FMXInputDemo:Clean;RetroTune:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="RetroMul:Make;RetromulTerm:Make;FMXInputDemo:Make;RetroTune:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
