  FMXAudio.AAC.PS;

type
  TSBRComplex = TPSComplex;

  TSBRBands = array[0..48] of Integer;

  TSBRUSACConfig = record
    StartFreq, StopFreq, FreqScale, AlterScale, NoiseBands: Integer;
    LimiterBands, LimiterGains, Interpolate, Smoothing: Integer;
    Harmonic, InterTES, PVC: Boolean;
  end;

  TSBRChannel = record
    NumEnv, NumNoise, FrameClass, AmpRes, OldEnd, YPos, NoiseIndex, SineIndex: Integer;
    EA: array[0..1] of Integer;
    Res, TEnv: array[0..8] of Integer;
    TQ: array[0..2] of Integer;
    DFEnv, TESMode: array[0..7] of Integer;
    DFNoise: array[0..1] of Integer;
    InvF: array[0..1, 0..4] of Integer;
    Harmonic: array[0..47] of Integer;
    HarmonicFlag: Boolean;
    EnvQ: array[0..8, 0..47] of Integer;
    NoiseQ: array[0..2, 0..4] of Integer;
    Env: array[0..8, 0..47] of Double;
    Noise: array[0..2, 0..4] of Double;
    BW: array[0..4] of Double;
    Analysis: array[0..1311] of Double;
    Synthesis: array[0..2303] of Double;
    SynthOffset: Integer;
    W: array[0..1, 0..31, 0..31] of TSBRComplex;
    Y: array[0..1, 0..37, 0..63] of TSBRComplex;
    GTemp, QTemp: array[0..41, 0..47] of Double;
    SIndex: array[0..8, 0..47] of Integer;
  end;

  TAACSBR = class
  private
    FRate, FChannels, FFrameLength, FSlots: Integer;
    FDownsampled: Boolean;
    FUSAC, FIndependent, FInterTES, FPreProcess: Boolean;
    FPS: TAACParametricStereo;
    FVLC: array[0..9] of TVLCTable;
    FMDCT: TInverseMDCT;
    FData: array[0..1] of TSBRChannel;
    FStart, FReset, FCoupling, FReady: Boolean;
    FStartFreq, FStopFreq, FXOver, FFreqScale, FAlterScale, FNoiseBands: Integer;
    FAmpRes, FLimiterBands, FLimiterGains, FInterpolate, FSmoothing: Integer;
    FK0, FK2, FMasterCount, FNoiseCount, FLimiterCount, FPatchCount: Integer;
    FKX, FM, FN: array[0..1] of Integer;
    FMaster, FHigh, FLow, FNoiseTable, FLimiter: TSBRBands;
    FPatchStart, FPatchSize: array[0..5] of Integer;
    FXLow: array[0..31, 0..39] of TSBRComplex;
    FXHigh: array[0..63, 0..39] of TSBRComplex;
    FAlpha0, FAlpha1: array[0..31] of TSBRComplex;
    FEOrig, FQMapped, FECurr, FGain, FQM, FSM: array[0..7, 0..47] of Double;
    FSMapped: array[0..7, 0..47] of Integer;
    function GetParametricStereo: Boolean;
    procedure MakeTables;
    procedure MakeLimiter;
    procedure ReadGrid(var Bits: TBitReader; var D: TSBRChannel);
    procedure ReadPayload(var R: TBitReader; DataExtra: Boolean);
    procedure ReadDelta(var Bits: TBitReader; var D: TSBRChannel);
    procedure ReadInvF(var Bits: TBitReader; var D: TSBRChannel);
    procedure ReadEnvelope(var Bits: TBitReader; var D: TSBRChannel; Channel: Integer);
    procedure ReadNoise(var Bits: TBitReader; var D: TSBRChannel; Channel: Integer);
    procedure Dequant;
    procedure Analyze(var D: TSBRChannel; const Samples: TFloatSamples);
    procedure Generate(var D: TSBRChannel);
    procedure Adjust(var D: TSBRChannel);
    procedure ApplyInterTES(var D: TSBRChannel);
    procedure Synthesize(var D: TSBRChannel; out Samples: TFloatSamples; QMF: PPSQMF = nil);
  public
    constructor Create(Rate, Channels: Integer; Downsampled: Boolean = False; FrameLength: Integer = 1024);
    destructor Destroy; override;
    procedure Reset;
    procedure BeginFrame;
    procedure ReadExtension(var Bits: TBitReader; Count: Integer; Crc: Boolean);
    procedure ReadUSAC(var Bits: TBitReader; const Defaults: TSBRUSACConfig; Independent: Boolean);
    procedure EnablePS;
    procedure ProcessStereo(var Left: TFloatSamples; out Right: TFloatSamples);
    property ParametricStereo: Boolean read GetParametricStereo;
    procedure Process(Channel: Integer; var Samples: TFloatSamples);
  end;

procedure ReadUSACSBRConfig(var Bits: TBitReader; out Config: TSBRUSACConfig);

