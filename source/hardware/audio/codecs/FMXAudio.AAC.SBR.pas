procedure Require(Value: Boolean; const MessageText: string);
begin
  if not Value then
    raise EPlayerFormat.Create('SBR: ' + MessageText)
end;

procedure SortBands(var A: TSBRBands; Start, Count: Integer);
var
  i, j, V: Integer;
begin
  Require((Start >= 0) and (Count >= 0) and (Start + Count <= Length(A)), 'band table bounds');
  for i := Start + 1 to Start + Count - 1 do
  begin
    V := A[i];
    j := i - 1;
    while (j >= Start) and (A[j] > V) do
    begin
      A[j + 1] := A[j];
      Dec(j)
    end;
    A[j + 1] := V
  end;
end;

procedure MakeBands(var A: TSBRBands; Offset, Start, Stop, Count: Integer);
var
  i, Prev, V: Integer;
  Base, Prod: Single;
begin
  Require(
    (Count > 0) and (Offset + Count <= Length(A)) and (Start > 0) and (Stop > Start),
    'invalid logarithmic bands'
  );
  Base := Power(Stop / Start, 1 / Count);
  Prod := Start;
  Prev := Start;
  for i := 0 to Count - 2 do
  begin
    Prod := Prod * Base;
    V := Round(Prod);
    A[Offset + i] := V - Prev;
    Prev := V
  end;
  A[Offset + Count - 1] := Stop - Prev;
end;

constructor TAACSBR.Create(Rate, Channels: Integer; Downsampled: Boolean; FrameLength: Integer);
begin
  inherited Create;
  FRate := Rate;
  FChannels := Channels;
  FFrameLength := FrameLength;
  FSlots := FrameLength div 32;
  Require((FrameLength = 960) or (FrameLength = 1024), 'invalid SBR core frame length');
  FDownsampled := Downsampled;
  FMDCT := TInverseMDCT.Create(64);
  FVLC[0].Build(SBR0_CODES, SBR0_BITS);
  FVLC[1].Build(SBR1_CODES, SBR1_BITS);
  FVLC[2].Build(SBR2_CODES, SBR2_BITS);
  FVLC[3].Build(SBR3_CODES, SBR3_BITS);
  FVLC[4].Build(SBR4_CODES, SBR4_BITS);
  FVLC[5].Build(SBR5_CODES, SBR5_BITS);
  FVLC[6].Build(SBR6_CODES, SBR6_BITS);
  FVLC[7].Build(SBR7_CODES, SBR7_BITS);
  FVLC[8].Build(SBR8_CODES, SBR8_BITS);
  FVLC[9].Build(SBR9_CODES, SBR9_BITS);
  Reset;
end;

destructor TAACSBR.Destroy;
begin
  FPS.Free;
  FMDCT.Free;
  inherited
end;

procedure TAACSBR.Reset;
begin
  if FPS <> nil then
    FPS.Reset;
  FillChar(FData, SizeOf(FData), 0);
  FStart := False;
  FReset := False;
  FCoupling := False;
  FReady := False;
  FKX[0] := 32;
  FKX[1] := 32;
  FM[0] := 0;
  FM[1] := 0;
  FStartFreq := -1;
  FStopFreq := -1;
  FXOver := -1;
  FFreqScale := -1;
  FAlterScale := -1;
  FNoiseBands := -1;
  FData[0].EA[1] := -1;
  FData[1].EA[1] := -1;
  FData[0].SynthOffset := 1152;
  FData[1].SynthOffset := 1152;
end;

procedure TAACSBR.BeginFrame;
begin
  FReady := False;
  FReset := False;
  FKX[0] := FKX[1];
  FM[0] := FM[1];
end;

procedure TAACSBR.MakeTables;
var
  Row, Temp, StartMin, StopMin, k, K1, DK, Diff, N0, N1, HalfBands, VMax, VMin, Change: Integer;
  MSB, USB, Goal, LastK, LastMSB, SB, Odd, I: Integer;
  A, B: TSBRBands;
  Warp: Single;
begin
  case FRate of
    16000:
      Row := 0;
    22050:
      Row := 1;
    24000:
      Row := 2;
    32000:
      Row := 3;
    44100, 48000, 64000:
      Row := 4;
    88200, 96000, 128000, 176400, 192000:
      Row := 5;
  else
    raise EPlayerUnsupported.CreateFmt('Unsupported SBR sample rate %d', [FRate]);
  end;
  if FRate < 32000 then
    Temp := 3000
  else if FRate < 64000 then
    Temp := 4000
  else
    Temp := 5000;
  StartMin := ((Temp shl 7) + FRate div 2) div FRate;
  StopMin := ((Temp shl 8) + FRate div 2) div FRate;
  FK0 := StartMin + OFFSETS[Row, FStartFreq];
  if FStopFreq < 14 then
  begin
    FK2 := StopMin;
    MakeBands(A, 0, StopMin, 64, 13);
    SortBands(A, 0, 13);
    for k := 0 to FStopFreq - 1 do
      Inc(FK2, A[k]);
  end
  else
    FK2 := (FStopFreq - 12) * FK0;
  FK2 := Min(64, FK2);
  if FRate <= 32000 then
    Temp := 48
  else if FRate = 44100 then
    Temp := 35
  else
    Temp := 32;
  Require((FK0 > 0) and (FK2 > FK0) and (FK2 - FK0 <= Temp), 'invalid frequency range');
  if FFreqScale = 0 then
  begin
    DK := FAlterScale + 1;
    FMasterCount := ((FK2 - FK0 + (DK and 2)) shr DK) shl 1;
    Require((FMasterCount > 0) and (FMasterCount <= 48), 'master band count');
    for k := 1 to FMasterCount do
      FMaster[k] := DK;
    Diff := FK2 - FK0 - FMasterCount * DK;
    if Diff < 0 then
    begin
      Dec(FMaster[1]);
      if Diff < -1 then
        Dec(FMaster[2])
    end
    else if Diff <> 0 then
      Inc(FMaster[FMasterCount]);
    FMaster[0] := FK0;
    for k := 1 to FMasterCount do
      Inc(FMaster[k], FMaster[k - 1]);
  end
  else
  begin
    HalfBands := 7 - FFreqScale;
    if 49 * FK2 > 110 * FK0 then
      K1 := 2 * FK0
    else
      K1 := FK2;
    N0 := Round(Single(HalfBands * Log2(Single(K1 / FK0)))) * 2;
    MakeBands(A, 1, FK0, K1, N0);
    SortBands(A, 1, N0);
    VMax := A[N0];
    A[0] := FK0;
    for k := 1 to N0 do
    begin
      Require(A[k] > 0, 'zero master band');
      Inc(A[k], A[k - 1])
    end;
    FMaster := A;
    FMasterCount := N0;
    if K1 <> FK2 then
    begin
      if FAlterScale <> 0 then
        Warp := 0.7692307692307692
      else
        Warp := 1;
      N1 := Round(Single(HalfBands * Warp * Log2(Single(FK2 / K1)))) * 2;
      Require(N0 + N1 <= 48, 'master band count');
      MakeBands(B, 1, K1, FK2, N1);
      VMin := B[1];
      for k := 2 to N1 do
        VMin := Min(VMin, B[k]);
      if VMin < VMax then
      begin
        SortBands(B, 1, N1);
        Change := Min(VMax - B[1], (B[N1] - B[1]) shr 1);
        Inc(B[1], Change);
        Dec(B[N1], Change);
      end;
      SortBands(B, 1, N1);
      B[0] := K1;
      for k := 1 to N1 do
      begin
        Require(B[k] > 0, 'zero master band');
        Inc(B[k], B[k - 1]);
        FMaster[N0 + k] := B[k]
      end;
      Inc(FMasterCount, N1);
    end;
  end;
  Require((FXOver >= 0) and (FXOver < FMasterCount), 'crossover exceeds bands');
  FN[1] := FMasterCount - FXOver;
  FN[0] := (FN[1] + 1) div 2;
  for k := 0 to FN[1] do
    FHigh[k] := FMaster[FXOver + k];
  FKX[1] := FHigh[0];
  FM[1] := FHigh[FN[1]] - FKX[1];
  Require((FKX[1] <= 32) and (FM[1] <= 48) and (FKX[1] + FM[1] <= 64), 'derived bands');
  FLow[0] := FHigh[0];
  for k := 1 to FN[0] do
    FLow[k] := FHigh[2 * k - (FN[1] and 1)];
  FNoiseCount := Max(1, Round(Single(FNoiseBands * Log2(Single(FK2 / FKX[1])))));
  Require(FNoiseCount <= 5, 'noise band count');
  FNoiseTable[0] := FLow[0];
  Temp := 0;
  for k := 1 to FNoiseCount do
  begin
    Inc(Temp, (FN[0] - Temp) div (FNoiseCount + 1 - k));
    FNoiseTable[k] := FLow[Temp]
  end;
  MSB := FK0;
  USB := FKX[1];
  Goal := ((1000 shl 11) + FRate div 2) div FRate;
  if Goal < FKX[1] + FM[1] then
  begin
    k := 0;
    while FMaster[k] < Goal do
      Inc(k)
  end
  else
    k := FMasterCount;
  FPatchCount := 0;
  LastK := -1;
  LastMSB := -1;
  repeat
    Require((k <> LastK) or (MSB <> LastMSB), 'patch construction stalled');
    LastK := k;
    LastMSB := MSB;
    I := k;
    repeat
      Require(I >= 0, 'patch underflow');
      SB := FMaster[I];
      Odd := (SB + FK0) and 1;
      Dec(I)
    until SB <= FK0 - 1 + MSB - Odd;
    Require(FPatchCount <= 5, 'too many patches');
    FPatchSize[FPatchCount] := Max(SB - USB, 0);
    FPatchStart[FPatchCount] := FK0 - Odd - FPatchSize[FPatchCount];
    if FPatchSize[FPatchCount] > 0 then
    begin
      USB := SB;
      MSB := SB;
      Inc(FPatchCount)
    end
    else
      MSB := FKX[1];
    if FMaster[k] - SB < 3 then
      k := FMasterCount;
  until SB = FKX[1] + FM[1];
  if (FPatchCount > 1) and (FPatchSize[FPatchCount - 1] < 3) then
    Dec(FPatchCount);
  MakeLimiter;
  FData[0].NoiseIndex := 0;
  FData[1].NoiseIndex := 0;
end;

procedure TAACSBR.MakeLimiter;
const
  WARPS: array[0..2] of Double = (1.327151742338568, 1.185092770941582, 1.119871604046759);
var
  Borders: TSBRBands;
  i, n, InPos, OutPos: Integer;

  function IsBorder(Value: Integer): Boolean;
  var
    j: Integer;
  begin
    Result := False;
    for j := 0 to FPatchCount do
      if Borders[j] = Value then
        Exit(True)
  end;

begin
  if FLimiterBands = 0 then
  begin
    FLimiter[0] := FLow[0];
    FLimiter[1] := FLow[FN[0]];
    FLimiterCount := 1;
    Exit
  end;
  Borders[0] := FKX[1];
  for i := 1 to FPatchCount do
    Borders[i] := Borders[i - 1] + FPatchSize[i - 1];
  FLimiter := FLow;
  n := FN[0] + 1;
  for i := 1 to FPatchCount - 1 do
  begin
    FLimiter[n] := Borders[i];
    Inc(n)
  end;
  SortBands(FLimiter, 0, n);
  InPos := 1;
  OutPos := 0;
  while InPos < n do
  begin
    if FLimiter[InPos] >= FLimiter[OutPos] * WARPS[FLimiterBands - 1] then
    begin
      Inc(OutPos);
      FLimiter[OutPos] := FLimiter[InPos]
    end
    else if (FLimiter[InPos] <> FLimiter[OutPos]) and IsBorder(FLimiter[InPos]) then
    begin
      if IsBorder(FLimiter[OutPos]) then
        Inc(OutPos);
      FLimiter[OutPos] := FLimiter[InPos];
    end;
    Inc(InPos);
  end;
  FLimiterCount := OutPos;
end;

procedure TAACSBR.ReadGrid(var Bits: TBitReader; var D: TSBRChannel);
const
  LOG_BITS: array[0..8] of Integer = (0, 1, 2, 2, 3, 3, 3, 3, 4);
var
  Old, i, Lead, Trail, AbsTrail, Pointer, Idx: Integer;
begin
  Old := D.NumEnv;
  D.Res[0] := D.Res[Old];
  D.OldEnd := D.TEnv[Old];
  D.AmpRes := FAmpRes;
  D.FrameClass := Bits.ReadBits(2);
  AbsTrail := FSlots div 2;
  Pointer := 0;
  case D.FrameClass of
    0:
      begin
        D.NumEnv := 1 shl Bits.ReadBits(2);
        Require(D.NumEnv <= IfThen(FUSAC, 8, 5), 'too many envelopes');
        if D.NumEnv = 1 then
          D.AmpRes := 0;
        D.TEnv[0] := 0;
        D.TEnv[D.NumEnv] := FSlots div 2;
        for i := 1 to D.NumEnv - 1 do
          D.TEnv[i] := D.TEnv[i - 1] + (FSlots div 2 + D.NumEnv div 2) div D.NumEnv;
        D.Res[1] := Bits.ReadBits(1);
        for i := 2 to D.NumEnv do
          D.Res[i] := D.Res[1];
      end;
    1:
      begin
        Inc(AbsTrail, Bits.ReadBits(2));
        Trail := Bits.ReadBits(2);
        D.NumEnv := Trail + 1;
        D.TEnv[0] := 0;
        D.TEnv[D.NumEnv] := AbsTrail;
        for i := 0 to Trail - 1 do
          D.TEnv[D.NumEnv - 1 - i] := D.TEnv[D.NumEnv - i] - 2 * Integer(Bits.ReadBits(2)) - 2;
        Pointer := Bits.ReadBits(LOG_BITS[D.NumEnv]);
        for i := 0 to D.NumEnv - 1 do
          D.Res[D.NumEnv - i] := Bits.ReadBits(1);
      end;
    2:
      begin
        D.TEnv[0] := Bits.ReadBits(2);
        Lead := Bits.ReadBits(2);
        D.NumEnv := Lead + 1;
        D.TEnv[D.NumEnv] := FSlots div 2;
        for i := 0 to Lead - 1 do
          D.TEnv[i + 1] := D.TEnv[i] + 2 * Integer(Bits.ReadBits(2)) + 2;
        Pointer := Bits.ReadBits(LOG_BITS[D.NumEnv]);
        for i := 1 to D.NumEnv do
          D.Res[i] := Bits.ReadBits(1);
      end;
    3:
      begin
        D.TEnv[0] := Bits.ReadBits(2);
        Inc(AbsTrail, Bits.ReadBits(2));
        Lead := Bits.ReadBits(2);
        Trail := Bits.ReadBits(2);
        D.NumEnv := Lead + Trail + 1;
        Require(D.NumEnv <= IfThen(FUSAC, 8, 5), 'too many envelopes');
        D.TEnv[D.NumEnv] := AbsTrail;
        for i := 0 to Lead - 1 do
          D.TEnv[i + 1] := D.TEnv[i] + 2 * Integer(Bits.ReadBits(2)) + 2;
        for i := 0 to Trail - 1 do
          D.TEnv[D.NumEnv - 1 - i] := D.TEnv[D.NumEnv - i] - 2 * Integer(Bits.ReadBits(2)) - 2;
        Pointer := Bits.ReadBits(LOG_BITS[D.NumEnv]);
        for i := 1 to D.NumEnv do
          D.Res[i] := Bits.ReadBits(1);
      end;
  end;
  Require(Pointer <= D.NumEnv + 1, 'invalid envelope pointer');
  for i := 1 to D.NumEnv do
    Require((D.TEnv[i - 1] < D.TEnv[i]) and (D.TEnv[i] <= FSlots div 2 + 3), 'nonmonotonic time borders');
  D.NumNoise := 1 + Ord(D.NumEnv > 1);
  D.TQ[0] := D.TEnv[0];
  D.TQ[D.NumNoise] := D.TEnv[D.NumEnv];
  if D.NumNoise = 2 then
  begin
    if D.FrameClass = 0 then
      Idx := D.NumEnv div 2
    else if Odd(D.FrameClass) then
      Idx := D.NumEnv - Max(Pointer - 1, 1)
    else if Pointer = 0 then
      Idx := 1
    else if Pointer = 1 then
      Idx := D.NumEnv - 1
    else
      Idx := Pointer - 1;
    D.TQ[1] := D.TEnv[Idx];
  end;
  D.EA[0] := -Ord(D.EA[1] <> Old);
  D.EA[1] := -1;
  if Odd(D.FrameClass) and (Pointer <> 0) then
    D.EA[1] := D.NumEnv + 1 - Pointer
  else if (D.FrameClass = 2) and (Pointer > 1) then
    D.EA[1] := Pointer - 1;
end;

procedure TAACSBR.ReadDelta(var Bits: TBitReader; var D: TSBRChannel);
var
  i: Integer;
begin
  for i := 0 to D.NumEnv - 1 do
    if FUSAC and FIndependent and (i = 0) then
      D.DFEnv[i] := 0
    else
      D.DFEnv[i] := Bits.ReadBits(1);
  for i := 0 to D.NumNoise - 1 do
    if FUSAC and FIndependent and (i = 0) then
      D.DFNoise[i] := 0
    else
      D.DFNoise[i] := Bits.ReadBits(1)
end;

procedure TAACSBR.ReadInvF(var Bits: TBitReader; var D: TSBRChannel);
var
  i: Integer;
begin
  D.InvF[1] := D.InvF[0];
  for i := 0 to FNoiseCount - 1 do
    D.InvF[0, i] := Bits.ReadBits(2)
end;

procedure TAACSBR.ReadEnvelope(var Bits: TBitReader; var D: TSBRChannel; Channel: Integer);
var
  T, F, ValueBits, Delta, i, j, K, N: Integer;
begin
  Delta := 1;
  if FCoupling and (Channel = 1) then
  begin
    Delta := 2;
    if D.AmpRes <> 0 then
    begin
      T := 6;
      F := 7;
      ValueBits := 5
    end
    else
    begin
      T := 2;
      F := 3;
      ValueBits := 6
    end
  end
  else if D.AmpRes <> 0 then
  begin
    T := 4;
    F := 5;
    ValueBits := 6
  end
  else
  begin
    T := 0;
    F := 1;
    ValueBits := 7
  end;
  for i := 0 to D.NumEnv - 1 do
  begin
    N := FN[D.Res[i + 1]];
    if D.DFEnv[i] <> 0 then
      for j := 0 to N - 1 do
      begin
        if D.Res[i + 1] = D.Res[i] then
          K := j
        else if D.Res[i + 1] <> 0 then
          K := (j + (FN[1] and 1)) div 2
        else if j = 0 then
          K := 0
        else
          K := 2 * j - (FN[1] and 1);
        D.EnvQ[i + 1, j] := D.EnvQ[i, K] + Delta * (Integer(Bits.ReadVLC(FVLC[T])) + SBR_OFFSETS[T]);
      end
    else
    begin
      D.EnvQ[i + 1, 0] := Delta * Integer(Bits.ReadBits(ValueBits));
      for j := 1 to N - 1 do
        D.EnvQ[i + 1, j] := D.EnvQ[i + 1, j - 1] + Delta * (Integer(Bits.ReadVLC(FVLC[F])) + SBR_OFFSETS[F]);
    end;
    for j := 0 to N - 1 do
      Require((D.EnvQ[i + 1, j] >= 0) and (D.EnvQ[i + 1, j] <= 127), 'envelope scale out of range');
    D.TESMode[i] := 0;
    if FUSAC and FInterTES and Bits.ReadBit then
      D.TESMode[i] := Bits.ReadBits(2);
  end;
  D.EnvQ[0] := D.EnvQ[D.NumEnv];
end;

procedure TAACSBR.ReadNoise(var Bits: TBitReader; var D: TSBRChannel; Channel: Integer);
var
  T, F, Delta, i, j: Integer;
begin
  if FCoupling and (Channel = 1) then
  begin
    T := 9;
    F := 7;
    Delta := 2
  end
  else
  begin
    T := 8;
    F := 5;
    Delta := 1
  end;
  for i := 0 to D.NumNoise - 1 do
  begin
    if D.DFNoise[i] <> 0 then
      for j := 0 to FNoiseCount - 1 do
        D.NoiseQ[i + 1, j] := D.NoiseQ[i, j] + Delta * (Bits.ReadVLC(FVLC[T]) + SBR_OFFSETS[T])
    else
    begin
      D.NoiseQ[i + 1, 0] := Delta * Integer(Bits.ReadBits(5));
      for j := 1 to FNoiseCount - 1 do
        D.NoiseQ[i + 1, j] := D.NoiseQ[i + 1, j - 1] + Delta * (Bits.ReadVLC(FVLC[F]) + SBR_OFFSETS[F]);
    end;
    for j := 0 to FNoiseCount - 1 do
      Require((D.NoiseQ[i + 1, j] >= 0) and (D.NoiseQ[i + 1, j] <= 30), 'noise scale out of range');
  end;
  D.NoiseQ[0] := D.NoiseQ[D.NumNoise];
end;

procedure ReadUSACSBRConfig(var Bits: TBitReader; out Config: TSBRUSACConfig);
var
  Extra1, Extra2: Boolean;
begin
  Config := Default(TSBRUSACConfig);
  Config.Harmonic := Bits.ReadBit;
  Config.InterTES := Bits.ReadBit;
  Config.PVC := Bits.ReadBit;
  if Config.Harmonic or Config.PVC then
    raise EPlayerUnsupported.Create('USAC harmonic/PVC SBR is not implemented');
  Config.StartFreq := Bits.ReadBits(4);
  Config.StopFreq := Bits.ReadBits(4);
  Extra1 := Bits.ReadBit;
  Extra2 := Bits.ReadBit;
  Config.FreqScale := 2;
  Config.AlterScale := 1;
  Config.NoiseBands := 2;
  Config.LimiterBands := 2;
  Config.LimiterGains := 2;
  Config.Interpolate := 1;
  Config.Smoothing := 1;
  if Extra1 then
  begin
    Config.FreqScale := Bits.ReadBits(2);
    Config.AlterScale := Bits.ReadBits(1);
    Config.NoiseBands := Bits.ReadBits(2);
  end;
  if Extra2 then
  begin
    Config.LimiterBands := Bits.ReadBits(2);
    Config.LimiterGains := Bits.ReadBits(2);
    Config.Interpolate := Bits.ReadBits(1);
    Config.Smoothing := Bits.ReadBits(1);
  end;
end;

procedure TAACSBR.ReadUSAC(var Bits: TBitReader; const Defaults: TSBRUSACConfig; Independent: Boolean);
var
  InfoPresent, HeaderPresent, UseDefault, Extra1, Extra2: Boolean;
  Header: TSBRUSACConfig;
  OldX, OldLimiter: Integer;
begin
  Require(not FReady, 'duplicate USAC SBR data');
  FUSAC := True;
  FIndependent := Independent;
  FInterTES := Defaults.InterTES;
  InfoPresent := True;
  HeaderPresent := True;
  OldX := FXOver;
  if not Independent then
  begin
    InfoPresent := Bits.ReadBit;
    HeaderPresent := InfoPresent and Bits.ReadBit;
  end;
  if InfoPresent then
  begin
    FAmpRes := Bits.ReadBits(1);
    FXOver := Bits.ReadBits(4);
    FPreProcess := Bits.ReadBit;
  end;
  if HeaderPresent then
  begin
    UseDefault := Bits.ReadBit;
    Header := Defaults;
    if not UseDefault then
    begin
      Header.StartFreq := Bits.ReadBits(4);
      Header.StopFreq := Bits.ReadBits(4);
      Bits.Skip(2);
      Extra1 := Bits.ReadBit;
      Extra2 := Bits.ReadBit;
      Header.FreqScale := 2;
      Header.AlterScale := 1;
      Header.NoiseBands := 2;
      Header.LimiterBands := 2;
      Header.LimiterGains := 2;
      Header.Interpolate := 1;
      Header.Smoothing := 1;
      if Extra1 then
      begin
        Header.FreqScale := Bits.ReadBits(2);
        Header.AlterScale := Bits.ReadBits(1);
        Header.NoiseBands := Bits.ReadBits(2);
      end;
      if Extra2 then
      begin
        Header.LimiterBands := Bits.ReadBits(2);
        Header.LimiterGains := Bits.ReadBits(2);
        Header.Interpolate := Bits.ReadBits(1);
        Header.Smoothing := Bits.ReadBits(1);
      end;
    end;
    FReset :=
      (Header.StartFreq <> FStartFreq)
      or (Header.StopFreq <> FStopFreq)
      or (Header.FreqScale <> FFreqScale)
      or (Header.AlterScale <> FAlterScale)
      or (Header.NoiseBands <> FNoiseBands)
      or (OldX <> FXOver);
    OldLimiter := FLimiterBands;
    FStartFreq := Header.StartFreq;
    FStopFreq := Header.StopFreq;
    FFreqScale := Header.FreqScale;
    FAlterScale := Header.AlterScale;
    FNoiseBands := Header.NoiseBands;
    FLimiterBands := Header.LimiterBands;
    FLimiterGains := Header.LimiterGains;
    FInterpolate := Header.Interpolate;
    FSmoothing := Header.Smoothing;
    FStart := True;
    if FReset then
      MakeTables
    else if OldLimiter <> FLimiterBands then
      MakeLimiter;
  end;
  Require(FStart, 'USAC SBR data before header');
  FReady := True;
  ReadPayload(Bits, False);
  Dequant;
end;

procedure TAACSBR.ReadPayload(var R: TBitReader; DataExtra: Boolean);
var
  Old, c, i: Integer;
begin
  if DataExtra and R.ReadBit then
    R.Skip(4 * FChannels);
  FCoupling := False;
  if FChannels = 2 then
    FCoupling := R.ReadBit;
  ReadGrid(R, FData[0]);
  if FChannels = 2 then
  begin
    if FCoupling then
    begin
      Old := FData[1].NumEnv;
      FData[1].Res[0] := FData[1].Res[Old];
      FData[1].OldEnd := FData[1].TEnv[Old];
      FData[1].EA[0] := -Ord(FData[1].EA[1] <> Old);
      for i := 1 to 8 do
        FData[1].Res[i] := FData[0].Res[i];
      FData[1].TEnv := FData[0].TEnv;
      FData[1].TQ := FData[0].TQ;
      FData[1].NumEnv := FData[0].NumEnv;
      FData[1].NumNoise := FData[0].NumNoise;
      FData[1].FrameClass := FData[0].FrameClass;
      FData[1].AmpRes := FData[0].AmpRes;
      FData[1].EA[1] := FData[0].EA[1];
    end
    else
      ReadGrid(R, FData[1]);
  end;
  for c := 0 to FChannels - 1 do
    ReadDelta(R, FData[c]);
  ReadInvF(R, FData[0]);
  if FChannels = 2 then
    if FCoupling then
    begin
      FData[1].InvF[1] := FData[1].InvF[0];
      FData[1].InvF[0] := FData[0].InvF[0]
    end
    else
      ReadInvF(R, FData[1]);
  if FCoupling then
  begin
    ReadEnvelope(R, FData[0], 0);
    ReadNoise(R, FData[0], 0);
    ReadEnvelope(R, FData[1], 1);
    ReadNoise(R, FData[1], 1);
  end
  else
  begin
    for c := 0 to FChannels - 1 do
      ReadEnvelope(R, FData[c], c);
    for c := 0 to FChannels - 1 do
      ReadNoise(R, FData[c], c);
  end;
  for c := 0 to FChannels - 1 do
  begin
    FData[c].HarmonicFlag := R.ReadBit;
    FillChar(FData[c].Harmonic, SizeOf(FData[c].Harmonic), 0);
    if FData[c].HarmonicFlag then
      for i := 0 to FN[1] - 1 do
        FData[c].Harmonic[i] := R.ReadBits(1);
  end;
end;

procedure TAACSBR.ReadExtension(var Bits: TBitReader; Count: Integer; Crc: Boolean);
var
  R: TBitReader;
  EndBit, SF, St, X, Scale, Alter, Noise, OldLim, i, N: Integer;
  Extra1, Extra2: Boolean;
  CRCBits: TBitReader;
  ExpectedCRC, ActualCRC: Cardinal;
begin
  Require((Count > 0) and (Count * 8 - 4 <= Bits.Remaining), 'truncated fill extension');
  Require(not FReady, 'duplicate SBR extension');
  Require(not Crc or (Count * 8 - 4 >= 11), 'truncated SBR CRC/header flag');
  FReady := True;
  R := Bits;
  EndBit := R.Position + Count * 8 - 4;
  Bits.Skip(Count * 8 - 4);
  FReset := False;
  FKX[0] := FKX[1];
  FM[0] := FM[1];
  if Crc then
  begin
    ExpectedCRC := R.ReadBits(10);
    CRCBits := R;
    ActualCRC := 0;
    while CRCBits.Position < EndBit do
    begin
      if ((ActualCRC shr 9) xor CRCBits.ReadBits(1)) and 1 <> 0 then
        ActualCRC := ((ActualCRC shl 1) xor $233) and $3FF
      else
        ActualCRC := (ActualCRC shl 1) and $3FF;
    end;
    Require(ActualCRC = ExpectedCRC, 'CRC mismatch');
  end;
  if R.ReadBit then
  begin
    FAmpRes := R.ReadBits(1);
    SF := R.ReadBits(4);
    St := R.ReadBits(4);
    X := R.ReadBits(3);
    R.Skip(2);
    Extra1 := R.ReadBit;
    Extra2 := R.ReadBit;
    if Extra1 then
    begin
      Scale := R.ReadBits(2);
      Alter := R.ReadBits(1);
      Noise := R.ReadBits(2)
    end
    else
    begin
      Scale := 2;
      Alter := 1;
      Noise := 2
    end;
    FReset :=
      (SF <> FStartFreq)
      or (St <> FStopFreq)
      or (X <> FXOver)
      or (Scale <> FFreqScale)
      or (Alter <> FAlterScale)
      or (Noise <> FNoiseBands);
    FStartFreq := SF;
    FStopFreq := St;
    FXOver := X;
    FFreqScale := Scale;
    FAlterScale := Alter;
    FNoiseBands := Noise;
    OldLim := FLimiterBands;
    if Extra2 then
    begin
      FLimiterBands := R.ReadBits(2);
      FLimiterGains := R.ReadBits(2);
      FInterpolate := R.ReadBits(1);
      FSmoothing := R.ReadBits(1)
    end
    else
    begin
      FLimiterBands := 2;
      FLimiterGains := 2;
      FInterpolate := 1;
      FSmoothing := 1
    end;
    FStart := True;
    if FReset then
      MakeTables
    else if OldLim <> FLimiterBands then
      MakeLimiter;
  end;
  // Before the first header, HE-AAC uses the QMF upsampling path.
  Require(R.Position <= EndBit, 'header overread');
  if not FStart then
    Exit;
  ReadPayload(R, True);
  if R.ReadBit then
  begin
    N := R.ReadBits(4);
    if N = 15 then
      Inc(N, R.ReadBits(8));
    N := N * 8;
    Require(R.Position + N <= EndBit, 'extended data exceeds fill');
    if N > 7 then
    begin
      i := R.ReadBits(2);
      Dec(N, 2);
      if i = 2 then
      begin
        EnablePS;
        var BeginPS := R.Position;
        FPS.ReadData(R, N);
        Dec(N, R.Position - BeginPS);
      end;
    end;
    R.Skip(N);
  end;
  Require(R.Position <= EndBit, 'fill extension overread');
  Dequant;
end;

procedure TAACSBR.Dequant;
var
  c, e, k: Integer;
  A, B, Factor, Pan: Double;
begin
  if FCoupling then
  begin
    if FData[0].AmpRes <> 0 then
      Factor := 1
    else
      Factor := 0.5;
    Pan := 12 / Factor;
    for e := 1 to FData[0].NumEnv do
      for k := 0 to FN[FData[0].Res[e]] - 1 do
      begin
        A := Power(2, FData[0].EnvQ[e, k] * Factor + 7);
        B := Power(2, (Pan - FData[1].EnvQ[e, k]) * Factor);
        if A > 1E20 then
          A := 1;
        FData[0].Env[e, k] := A / (1 + B);
        FData[1].Env[e, k] := FData[0].Env[e, k] * B;
      end;
    for e := 1 to FData[0].NumNoise do
      for k := 0 to FNoiseCount - 1 do
      begin
        A := Power(2, 7 - FData[0].NoiseQ[e, k]);
        B := Power(2, 12 - FData[1].NoiseQ[e, k]);
        FData[0].Noise[e, k] := A / (1 + B);
        FData[1].Noise[e, k] := FData[0].Noise[e, k] * B;
      end;
  end
  else
    for c := 0 to FChannels - 1 do
    begin
      if FData[c].AmpRes <> 0 then
        Factor := 1
      else
        Factor := 0.5;
      for e := 1 to FData[c].NumEnv do
        for k := 0 to FN[FData[c].Res[e]] - 1 do
        begin
          A := Power(2, FData[c].EnvQ[e, k] * Factor + 6);
          if A > 1E20 then
            A := 1;
          FData[c].Env[e, k] := A;
        end;
      for e := 1 to FData[c].NumNoise do
        for k := 0 to FNoiseCount - 1 do
          FData[c].Noise[e, k] := Power(2, 6 - FData[c].NoiseQ[e, k]);
    end;
end;

procedure TAACSBR.Analyze(var D: TSBRChannel; const Samples: TFloatSamples);
var
  i, j, k, Base: Integer;
  Z: array[0..63] of Double;
  Input: array[0..63] of Double;
  Output: TFloatSamples;
begin
  Require(Length(Samples) = FFrameLength, 'core frame length');
  Move(D.Analysis[FFrameLength], D.Analysis[0], 288 * SizeOf(Double));
  Move(Samples[0], D.Analysis[288], FFrameLength * SizeOf(Double));
  for i := 0 to FSlots - 1 do
  begin
    Base := i * 32;
    for k := 0 to 63 do
    begin
      Z[k] := 0;
      for j := 0 to 4 do
        Z[k] := Z[k] + SBR_QMF_WINDOW_DS[k + j * 64] * D.Analysis[Base + 319 - k - j * 64];
    end;
    Input[0] := Z[0];
    Input[1] := Z[1];
    for k := 1 to 31 do
    begin
      Input[2 * k] := -Z[64 - k];
      Input[2 * k + 1] := Z[k + 1]
    end;
    FMDCT.Execute(Input, 0, Output);
    // FFmpeg's half IMDCT is the negated middle 64 of our full IMDCT.
    // Its analysis scale is -2 for PCM16-domain samples.
    for k := 0 to 31 do
    begin
      D.W[D.YPos, i, k, 0] := -2 * Output[32 + 63 - k];
      D.W[D.YPos, i, k, 1] := 2 * Output[32 + k];
    end;
  end;
  FillChar(FXLow, SizeOf(FXLow), 0);
  for k := 0 to FKX[1] - 1 do
    for i := 8 to FSlots + 7 do
      FXLow[k, i] := D.W[D.YPos, i - 8, k];
  for k := 0 to FKX[0] - 1 do
    for i := 0 to 7 do
      FXLow[k, i] := D.W[1 - D.YPos, i + FSlots - 8, k];
  D.YPos := 1 - D.YPos;
end;

// Cubic least-squares spectral envelope flattening (USAC eSBR).
procedure SBRPreprocessing(const Levels: array of Double; Count: Integer; out Gains: TFloatSamples);
var
  Matrix: array[0..3, 0..4] of Double;
  Powers: array[0..6] of Double;
  Mean, X, Factor, Value: Double;
begin
  SetLength(Gains, Count);
  for var i := 0 to Count - 1 do
    Gains[i] := 1;
  if Count < 4 then
    Exit;
  FillChar(Matrix, SizeOf(Matrix), 0);
  Mean := 0;
  for var i := 0 to Count - 1 do
  begin
    X := 2 * i / (Count - 1) - 1;
    Powers[0] := 1;
    for var j := 1 to 6 do
      Powers[j] := Powers[j - 1] * X;
    Mean := Mean + Levels[i];
    for var R := 0 to 3 do
    begin
      for var c := 0 to 3 do
        Matrix[R, c] := Matrix[R, c] + Powers[R + c];
      Matrix[R, 4] := Matrix[R, 4] + Levels[i] * Powers[R];
    end;
  end;
  Mean := Mean / Count;
  for var R := 0 to 3 do
  begin
    var Pivot := R;
    for var j := R + 1 to 3 do
      if Abs(Matrix[j, R]) > Abs(Matrix[Pivot, R]) then
        Pivot := j;
    for var c := R to 4 do
    begin
      Value := Matrix[R, c];
      Matrix[R, c] := Matrix[Pivot, c];
      Matrix[Pivot, c] := Value;
    end;
    Factor := Matrix[R, R];
    if Abs(Factor) < 1E-12 then
      Exit;
    for var c := R to 4 do
      Matrix[R, c] := Matrix[R, c] / Factor;
    for var j := 0 to 3 do
      if j <> R then
      begin
        Factor := Matrix[j, R];
        for var c := R to 4 do
          Matrix[j, c] := Matrix[j, c] - Factor * Matrix[R, c];
      end;
  end;
  for var i := 0 to Count - 1 do
  begin
    X := 2 * i / (Count - 1) - 1;
    Value := ((Matrix[3, 4] * X + Matrix[2, 4]) * X + Matrix[1, 4]) * X + Matrix[0, 4];
    Gains[i] := Power(10, (Mean - Value) / 20);
  end;
end;

procedure TAACSBR.Generate(var D: TSBRChannel);
const
  BW_TAB: array[0..3] of Double = (0, 0.75, 0.9, 0.98);
var
  k, i, j, P, g, Dest, Start, Stop: Integer;
  R0, R1, Im1, R2, Im2, P00R, P00I, P10, P11R, P11I, P21, Det, A, B, NewBW: Double;
  A0, A1: TSBRComplex;
  PreGain, Levels: TFloatSamples;
begin
  // Complex autocorrelation over 40 slots, with predictor reliability test.
  for k := 0 to FK0 - 1 do
  begin
    R0 := 0;
    R1 := 0;
    Im1 := 0;
    R2 := FXLow[k, 0, 0] * FXLow[k, 2, 0] + FXLow[k, 0, 1] * FXLow[k, 2, 1];
    Im2 := FXLow[k, 0, 0] * FXLow[k, 2, 1] - FXLow[k, 0, 1] * FXLow[k, 2, 0];
    for i := 1 to FSlots + 5 do
    begin
      R0 := R0 + Sqr(FXLow[k, i, 0]) + Sqr(FXLow[k, i, 1]);
      R1 := R1 + FXLow[k, i, 0] * FXLow[k, i + 1, 0] + FXLow[k, i, 1] * FXLow[k, i + 1, 1];
      Im1 := Im1 + FXLow[k, i, 0] * FXLow[k, i + 1, 1] - FXLow[k, i, 1] * FXLow[k, i + 1, 0];
      R2 := R2 + FXLow[k, i, 0] * FXLow[k, i + 2, 0] + FXLow[k, i, 1] * FXLow[k, i + 2, 1];
      Im2 := Im2 + FXLow[k, i, 0] * FXLow[k, i + 2, 1] - FXLow[k, i, 1] * FXLow[k, i + 2, 0];
    end;
    P21 := R0 + Sqr(FXLow[k, 0, 0]) + Sqr(FXLow[k, 0, 1]);
    P10 := R0 + Sqr(FXLow[k, FSlots + 6, 0]) + Sqr(FXLow[k, FSlots + 6, 1]);
    P11R := R1 + FXLow[k, 0, 0] * FXLow[k, 1, 0] + FXLow[k, 0, 1] * FXLow[k, 1, 1];
    P11I := Im1 + FXLow[k, 0, 0] * FXLow[k, 1, 1] - FXLow[k, 0, 1] * FXLow[k, 1, 0];
    P00R := R1 + FXLow[k, FSlots + 6, 0] * FXLow[k, FSlots + 7, 0] + FXLow[k, FSlots + 6, 1] * FXLow[k, FSlots + 7, 1];
    P00I := Im1 + FXLow[k, FSlots + 6, 0] * FXLow[k, FSlots + 7, 1] - FXLow[k, FSlots + 6, 1] * FXLow[k, FSlots + 7, 0];
    Det := P21 * P10 - (Sqr(P11R) + Sqr(P11I)) / 1.000001;
    A1 := Default(TSBRComplex);
    A0 := Default(TSBRComplex);
    if Det <> 0 then
    begin
      A1[0] := (P00R * P11R - P00I * P11I - R2 * P10) / Det;
      A1[1] := (P00R * P11I + P00I * P11R - Im2 * P10) / Det
    end;
    if P10 <> 0 then
    begin
      A0[0] := -(P00R + A1[0] * P11R + A1[1] * P11I) / P10;
      A0[1] := -(P00I + A1[1] * P11R - A1[0] * P11I) / P10
    end;
    if (Sqr(A0[0]) + Sqr(A0[1]) >= 16) or (Sqr(A1[0]) + Sqr(A1[1]) >= 16) then
    begin
      A0 := Default(TSBRComplex);
      A1 := Default(TSBRComplex)
    end;
    FAlpha0[k] := A0;
    FAlpha1[k] := A1;
  end;
  for g := 0 to FNoiseCount - 1 do
  begin
    if D.InvF[0, g] + D.InvF[1, g] = 1 then
      NewBW := 0.6
    else
      NewBW := BW_TAB[D.InvF[0, g]];
    if NewBW < D.BW[g] then
      NewBW := 0.75 * NewBW + 0.25 * D.BW[g]
    else
      NewBW := 0.90625 * NewBW + 0.09375 * D.BW[g];
    if NewBW < 0.015625 then
      NewBW := 0;
    D.BW[g] := NewBW;
  end;
  FillChar(FXHigh, SizeOf(FXHigh), 0);
  Dest := FKX[1];
  g := 0;
  Start := 2 * D.TEnv[0] + 2;
  Stop := 2 * D.TEnv[D.NumEnv] + 2;
  if FUSAC and FPreProcess then
  begin
    SetLength(Levels, FK0);
    for k := 0 to FK0 - 1 do
    begin
      A := 0;
      for i := Start to Stop - 1 do
        A := A + Sqr(FXLow[k, i, 0]) + Sqr(FXLow[k, i, 1]);
      Levels[k] := 10 * Log10(A / (Stop - Start) + 1);
    end;
    SBRPreprocessing(Levels, FK0, PreGain);
  end;
  for j := 0 to FPatchCount - 1 do
    for k := 0 to FPatchSize[j] - 1 do
    begin
      P := FPatchStart[j] + k;
      Require((P >= 0) and (P < 32) and (Dest < 64), 'patch source bounds');
      while (g + 1 < FNoiseCount) and (Dest >= FNoiseTable[g + 1]) do
        Inc(g);
      A0[0] := FAlpha0[P, 0] * D.BW[g];
      A0[1] := FAlpha0[P, 1] * D.BW[g];
      A1[0] := FAlpha1[P, 0] * Sqr(D.BW[g]);
      A1[1] := FAlpha1[P, 1] * Sqr(D.BW[g]);
      for i := Start to Stop - 1 do
      begin
        A :=
          FXLow[P, i - 2, 0] * A1[0]
          - FXLow[P, i - 2, 1] * A1[1]
          + FXLow[P, i - 1, 0] * A0[0]
          - FXLow[P, i - 1, 1] * A0[1]
          + FXLow[P, i, 0];
        B :=
          FXLow[P, i - 2, 1] * A1[0]
          + FXLow[P, i - 2, 0] * A1[1]
          + FXLow[P, i - 1, 1] * A0[0]
          + FXLow[P, i - 1, 0] * A0[1]
          + FXLow[P, i, 1];
        if Length(PreGain) <> 0 then
        begin
          A := A * PreGain[P];
          B := B * PreGain[P];
        end;
        FXHigh[Dest, i, 0] := A;
        FXHigh[Dest, i, 1] := B;
      end;
      Inc(Dest);
    end;
end;

procedure TAACSBR.Adjust(var D: TSBRChannel);
const
  LIM_GAIN: array[0..3] of Double = (0.70795, 1, 1.41254, 1E10);
  SMOOTH: array[0..4] of Double =
    (0.33333333333333, 0.30150283239582, 0.21816949906249, 0.11516383427084, 0.03183050093751);
var
  e, i, j, k, m, Band, N, NoiseEnv, Mid, Start, Stop, Lo, Hi, Delta, SL, NI, SI: Integer;
  Table: TSBRBands;
  Sum, Temp, Sum0, Sum1, GMax, Boost, GF, QF, Sign0, Sign1: Double;
  Present, Attack: Boolean;
begin
  for e := 1 to 8 do
    FillChar(D.SIndex[e], SizeOf(D.SIndex[e]), 0);
  for e := 0 to D.NumEnv - 1 do
  begin
    N := FN[D.Res[e + 1]];
    if D.Res[e + 1] <> 0 then
      Table := FHigh
    else
      Table := FLow;
    for Band := 0 to N - 1 do
      for k := Table[Band] to Table[Band + 1] - 1 do
        FEOrig[e, k - FKX[1]] := D.Env[e + 1, Band];
    NoiseEnv := 1;
    if (D.NumNoise > 1) and (D.TEnv[e] >= D.TQ[1]) then
      NoiseEnv := 2;
    for Band := 0 to FNoiseCount - 1 do
      for k := FNoiseTable[Band] to FNoiseTable[Band + 1] - 1 do
        FQMapped[e, k - FKX[1]] := D.Noise[NoiseEnv, Band];
    if D.HarmonicFlag then
      for Band := 0 to FN[1] - 1 do
      begin
        Mid := (FHigh[Band] + FHigh[Band + 1]) div 2 - FKX[1];
        D.SIndex[e + 1, Mid] := D.Harmonic[Band] * Ord((e >= D.EA[1]) or (D.SIndex[0, Mid] = 1));
      end;
    for Band := 0 to N - 1 do
    begin
      Present := False;
      for k := Table[Band] to Table[Band + 1] - 1 do
        if D.SIndex[e + 1, k - FKX[1]] <> 0 then
          Present := True;
      for k := Table[Band] to Table[Band + 1] - 1 do
        FSMapped[e, k - FKX[1]] := Ord(Present);
    end;
    Start := 2 * D.TEnv[e] + 2;
    Stop := 2 * D.TEnv[e + 1] + 2;
    if FInterpolate <> 0 then
      for m := 0 to FM[1] - 1 do
      begin
        Sum := 0;
        for i := Start to Stop - 1 do
          Sum := Sum + Sqr(FXHigh[m + FKX[1], i, 0]) + Sqr(FXHigh[m + FKX[1], i, 1]);
        FECurr[e, m] := Sum / (Stop - Start);
      end
    else
      for Band := 0 to N - 1 do
      begin
        Sum := 0;
        for k := Table[Band] to Table[Band + 1] - 1 do
          for i := Start to Stop - 1 do
            Sum := Sum + Sqr(FXHigh[k, i, 0]) + Sqr(FXHigh[k, i, 1]);
        Sum := Sum / ((Stop - Start) * (Table[Band + 1] - Table[Band]));
        for k := Table[Band] to Table[Band + 1] - 1 do
          FECurr[e, k - FKX[1]] := Sum;
      end;
    Delta := Ord((e <> D.EA[0]) and (e <> D.EA[1]));
    for Band := 0 to FLimiterCount - 1 do
    begin
      Lo := FLimiter[Band] - FKX[1];
      Hi := FLimiter[Band + 1] - FKX[1];
      Sum0 := 0;
      Sum1 := 0;
      for m := Lo to Hi - 1 do
      begin
        Temp := FEOrig[e, m] / (1 + FQMapped[e, m]);
        FQM[e, m] := Sqrt(Temp * FQMapped[e, m]);
        FSM[e, m] := Sqrt(Temp * D.SIndex[e + 1, m]);
        if FSMapped[e, m] = 0 then
          FGain[e, m] := Sqrt(FEOrig[e, m] / ((1 + FECurr[e, m]) * (1 + FQMapped[e, m] * Delta)))
        else
          FGain[e, m] := Sqrt(FEOrig[e, m] * FQMapped[e, m] / ((1 + FECurr[e, m]) * (1 + FQMapped[e, m])));
        FGain[e, m] := FGain[e, m] + 1.175494350822E-38;
        Sum0 := Sum0 + FEOrig[e, m];
        Sum1 := Sum1 + FECurr[e, m];
      end;
      GMax :=
        Min(
        100000.0,
        LIM_GAIN[FLimiterGains] * Sqrt((1.1920928955078125E-7 + Sum0) / (1.1920928955078125E-7 + Sum1))
      );
      Sum0 := 0;
      Sum1 := 0;
      for m := Lo to Hi - 1 do
      begin
        FQM[e, m] := Min(FQM[e, m], FQM[e, m] * GMax / FGain[e, m]);
        FGain[e, m] := Min(FGain[e, m], GMax);
        Sum0 := Sum0 + FEOrig[e, m];
        Sum1 := Sum1 + FECurr[e, m] * Sqr(FGain[e, m]) + Sqr(FSM[e, m]);
        if (Delta <> 0) and (FSM[e, m] = 0) then
          Sum1 := Sum1 + Sqr(FQM[e, m]);
      end;
      Boost := Min(1.584893192, Sqrt((1.1920928955078125E-7 + Sum0) / (1.1920928955078125E-7 + Sum1)));
      for m := Lo to Hi - 1 do
      begin
        FGain[e, m] := FGain[e, m] * Boost;
        FQM[e, m] := FQM[e, m] * Boost;
        FSM[e, m] := FSM[e, m] * Boost
      end;
    end;
  end;
  D.SIndex[0] := D.SIndex[D.NumEnv];
  SL := 4 * Ord(FSmoothing = 0);
  if FReset then
    for i := 0 to SL - 1 do
      for m := 0 to FM[1] - 1 do
      begin
        D.GTemp[i + 2 * D.TEnv[0], m] := FGain[0, m];
        D.QTemp[i + 2 * D.TEnv[0], m] := FQM[0, m];
      end
  else if SL <> 0 then
    for i := 0 to 3 do
    begin
      D.GTemp[i + 2 * D.TEnv[0]] := D.GTemp[i + 2 * D.OldEnd];
      D.QTemp[i + 2 * D.TEnv[0]] := D.QTemp[i + 2 * D.OldEnd];
    end;
  for e := 0 to D.NumEnv - 1 do
    for i := 2 * D.TEnv[e] to 2 * D.TEnv[e + 1] - 1 do
      for m := 0 to FM[1] - 1 do
      begin
        D.GTemp[SL + i, m] := FGain[e, m];
        D.QTemp[SL + i, m] := FQM[e, m];
      end;
  NI := D.NoiseIndex;
  SI := D.SineIndex;
  for e := 0 to D.NumEnv - 1 do
  begin
    Attack := (e = D.EA[0]) or (e = D.EA[1]);
    for i := 2 * D.TEnv[e] to 2 * D.TEnv[e + 1] - 1 do
    begin
      case SI of
        0:
          begin
            Sign0 := 1;
            Sign1 := 0
          end;
        1:
          begin
            Sign0 := 0;
            Sign1 := 1 - 2 * (FKX[1] and 1)
          end;
        2:
          begin
            Sign0 := -1;
            Sign1 := 0
          end;
      else
        begin
          Sign0 := 0;
          Sign1 := -(1 - 2 * (FKX[1] and 1))
        end;
      end;
      for m := 0 to FM[1] - 1 do
      begin
        if (SL <> 0) and not Attack then
        begin
          GF := 0;
          QF := 0;
          for j := 0 to 4 do
          begin
            GF := GF + D.GTemp[i + SL - j, m] * SMOOTH[j];
            QF := QF + D.QTemp[i + SL - j, m] * SMOOTH[j]
          end;
        end
        else
        begin
          GF := D.GTemp[i + SL, m];
          QF := D.QTemp[i, m]
        end;
        k := FKX[1] + m;
        D.Y[D.YPos, i, k, 0] := FXHigh[k, i + 2, 0] * GF;
        D.Y[D.YPos, i, k, 1] := FXHigh[k, i + 2, 1] * GF;
        NI := (NI + 1) and 511;
        if FSM[e, m] <> 0 then
        begin
          D.Y[D.YPos, i, k, 0] := D.Y[D.YPos, i, k, 0] + FSM[e, m] * Sign0;
          D.Y[D.YPos, i, k, 1] := D.Y[D.YPos, i, k, 1] + FSM[e, m] * Sign1;
        end
        else if not Attack then
        begin
          D.Y[D.YPos, i, k, 0] := D.Y[D.YPos, i, k, 0] + QF * SBR_NOISE[NI, 0];
          D.Y[D.YPos, i, k, 1] := D.Y[D.YPos, i, k, 1] + QF * SBR_NOISE[NI, 1];
        end;
        Sign1 := -Sign1;
      end;
      SI := (SI + 1) and 3;
    end;
  end;
  ApplyInterTES(D);
  D.NoiseIndex := NI;
  D.SineIndex := SI;
end;

// Preserve envelope energy while transferring the low-band temporal envelope.
procedure TAACSBR.ApplyInterTES(var D: TSBRChannel);
const
  Gamma: array[0..3] of Double = (0, 1, 2, 4);
var
  LowPower, HighPower, Gain: array[0..37] of Double;
  TotalLow, TotalHigh, TotalAfter, Adjustment: Double;
  Start, Stop, Count: Integer;
begin
  if not (FUSAC and FInterTES) then
    Exit;
  for var e := 0 to D.NumEnv - 1 do
  begin
    if D.TESMode[e] = 0 then
      Continue;
    Start := 2 * D.TEnv[e];
    Stop := 2 * D.TEnv[e + 1];
    Count := Stop - Start;
    TotalLow := 0;
    TotalHigh := 0;
    TotalAfter := 1E-6;
    for var i := Start to Stop - 1 do
    begin
      LowPower[i] := 0;
      HighPower[i] := 0;
      for var k := 0 to FKX[1] - 1 do
        LowPower[i] := LowPower[i] + Sqr(FXLow[k, i + 2, 0]) + Sqr(FXLow[k, i + 2, 1]);
      for var k := FKX[1] to FKX[1] + FM[1] - 1 do
        HighPower[i] := HighPower[i] + Sqr(D.Y[D.YPos, i, k, 0]) + Sqr(D.Y[D.YPos, i, k, 1]);
      TotalLow := TotalLow + LowPower[i];
      TotalHigh := TotalHigh + HighPower[i];
    end;
    for var i := Start to Stop - 1 do
    begin
      Gain[i] := Max(0.2, 1 + Gamma[D.TESMode[e]] * (Sqrt(LowPower[i] * Count / (TotalLow + 1E-6)) - 1));
      TotalAfter := TotalAfter + HighPower[i] * Sqr(Gain[i]);
    end;
    Adjustment := Sqrt(TotalHigh / TotalAfter);
    for var i := Start to Stop - 1 do
      for var k := FKX[1] to FKX[1] + FM[1] - 1 do
      begin
        D.Y[D.YPos, i, k, 0] := D.Y[D.YPos, i, k, 0] * Gain[i] * Adjustment;
        D.Y[D.YPos, i, k, 1] := D.Y[D.YPos, i, k, 1] * Gain[i] * Adjustment;
      end;
  end;
end;

procedure TAACSBR.Synthesize(var D: TSBRChannel; out Samples: TFloatSamples; QMF: PPSQMF);
const
  OFF: array[0..9] of Integer = (0, 192, 256, 448, 512, 704, 768, 960, 1024, 1216);
var
  i, k, j, VPos, OldSlots: Integer;
  InputR, InputI: array[0..63] of Double;
  OutR, OutI: TFloatSamples;
  X: TSBRComplex;
  Sum: Double;
begin
  OldSlots := Max(2 * D.OldEnd - FSlots, 0);
  SetLength(Samples, FFrameLength * 2 shr Ord(FDownsampled));
  for i := 0 to FSlots - 1 do
  begin
    FillChar(InputR, SizeOf(InputR), 0);
    FillChar(InputI, SizeOf(InputI), 0);
    for k := 0 to 63 do
    begin
      X := Default(TSBRComplex);
      if QMF <> nil then
        X := QMF^[i, k]
      else if i < OldSlots then
      begin
        if k < FKX[0] then
          X := FXLow[k, i + 2]
        else if k < FKX[0] + FM[0] then
          X := D.Y[1 - D.YPos, i + FSlots, k];
      end
      else
      begin
        if k < FKX[1] then
          X := FXLow[k, i + 2]
        else if k < FKX[1] + FM[1] then
          X := D.Y[D.YPos, i, k];
      end;
      InputR[k] := X[0];
      if Odd(k) then
        InputI[k] := -X[1]
      else
        InputI[k] := X[1];
    end;
    if FDownsampled then
    begin
      for k := 0 to 31 do
      begin
        InputR[k] := -InputR[k];
        if Odd(31 - k) then
          InputR[32 + k] := -InputI[31 - k]
        else
          InputR[32 + k] := InputI[31 - k];
      end;
      FMDCT.Execute(InputR, 0, OutR);
      if D.SynthOffset < 64 then
      begin
        Move(D.Synthesis[0], D.Synthesis[1728], 576 * SizeOf(Double));
        D.SynthOffset := 1664;
      end
      else
        Dec(D.SynthOffset, 64);
      VPos := D.SynthOffset;
      for k := 0 to 31 do
      begin
        D.Synthesis[VPos + k] := -OutR[95 - 2 * k] / 64;
        D.Synthesis[VPos + 63 - k] := OutR[94 - 2 * k] / 64;
      end;
      for k := 0 to 31 do
      begin
        Sum := 0;
        for j := 0 to 9 do
          Sum := Sum + D.Synthesis[VPos + OFF[j] div 2 + k] * SBR_QMF_WINDOW_DS[j * 32 + k];
        Samples[i * 32 + k] := Sum;
      end;
      Continue;
    end;
    FMDCT.Execute(InputR, 0, OutR);
    FMDCT.Execute(InputI, 0, OutI);
    if D.SynthOffset < 128 then
    begin
      Move(D.Synthesis[0], D.Synthesis[1152], 1152 * SizeOf(Double));
      D.SynthOffset := 1024;
    end
    else
      Dec(D.SynthOffset, 128);
    VPos := D.SynthOffset;
    for k := 0 to 63 do
    begin
      D.Synthesis[VPos + k] := (OutR[32 + 63 - k] - OutI[32 + k]) / 64;
      D.Synthesis[VPos + 127 - k] := -(OutI[32 + k] + OutR[32 + 63 - k]) / 64;
    end;
    for k := 0 to 63 do
    begin
      Sum := 0;
      for j := 0 to 9 do
        Sum := Sum + D.Synthesis[VPos + OFF[j] + k] * SBR_QMF_WINDOW_US[j * 64 + k];
      Samples[i * 64 + k] := Sum;
    end;
  end;
end;

function TAACSBR.GetParametricStereo: Boolean;
begin
  Result := FPS <> nil;
end;

procedure TAACSBR.EnablePS;
begin
  Require(FChannels = 1, 'parametric stereo requires mono core');
  if FPS = nil then
    FPS := TAACParametricStereo.Create(FSlots);
end;

procedure TAACSBR.ProcessStereo(var Left: TFloatSamples; out Right: TFloatSamples);
var
  LQMF, RQMF: TPSQMF;
  OldSlots: Integer;
  OutLeft: TFloatSamples;
begin
  Require(FPS <> nil, 'missing PS context');
  Analyze(FData[0], Left);
  if FStart then
  begin
    Generate(FData[0]);
    Adjust(FData[0]);
  end;
  LQMF := Default(TPSQMF);
  RQMF := Default(TPSQMF);
  OldSlots := Max(2 * FData[0].OldEnd - FSlots, 0);
  for var i := 0 to FSlots + 5 do
    for var k := 0 to 63 do
      if i < OldSlots then
      begin
        if k < FKX[0] then
          LQMF[i, k] := FXLow[k, i + 2]
        else if k < FKX[0] + FM[0] then
          LQMF[i, k] := FData[0].Y[1 - FData[0].YPos, i + FSlots, k];
      end
      else
      begin
        if k < FKX[1] then
          LQMF[i, k] := FXLow[k, i + 2]
        else if k < FKX[1] + FM[1] then
          LQMF[i, k] := FData[0].Y[FData[0].YPos, i, k];
      end;
  if FPS.Started then
    FPS.Apply(LQMF, RQMF, FKX[1] + FM[1])
  else
    RQMF := LQMF;
  Synthesize(FData[0], OutLeft, @LQMF);
  Synthesize(FData[1], Right, @RQMF);
  Left := OutLeft;
end;

procedure TAACSBR.Process(Channel: Integer; var Samples: TFloatSamples);
var
  OutSamples: TFloatSamples;
begin
  Require((Channel >= 0) and (Channel < FChannels), 'invalid channel');
  if not FReady then
  begin
    FStart := False;
    FKX[1] := 32;
    FM[1] := 0;
    FStartFreq := -1;
    FStopFreq := -1;
    FXOver := -1;
    FFreqScale := -1;
    FAlterScale := -1;
    FNoiseBands := -1;
    FData[0].EA[1] := -1;
    FData[1].EA[1] := -1;
  end;
  Analyze(FData[Channel], Samples);
  if FStart then
  begin
    Generate(FData[Channel]);
    Adjust(FData[Channel])
  end;
  Synthesize(FData[Channel], OutSamples);
  Samples := OutSamples;
end;

end.

