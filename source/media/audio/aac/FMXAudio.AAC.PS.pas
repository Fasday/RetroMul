    FLeft, FRight: TPSHybrid;
    procedure ReadParameters(var Bits: TBitReader; var Params: TPSParams; Envelope, Count, Table, Mask, Limit: Integer; Delta: Boolean);
    procedure Analyze(const QMF: TPSQMF);
    procedure Decorrelate;
    procedure Mix;
    procedure Synthesize(const Hybrid: TPSHybrid; var QMF: TPSQMF);
  public
    constructor Create(Slots: Integer = 32);
    procedure Reset;
    procedure ReadData(var Bits: TBitReader; BitCount: Integer);
