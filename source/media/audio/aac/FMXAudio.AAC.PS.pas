function CMultiply(const A, B: TPSComplex): TPSComplex; inline;
begin
  Result[0] := A[0] * B[0] - A[1] * B[1];
  Result[1] := A[0] * B[1] + A[1] * B[0];
end;

procedure PSRequire(Value: Boolean; const Text: string);
begin
  if not Value then
    raise EPlayerFormat.Create('AAC PS: ' + Text);
end;

function Remap(const Input: TPSParam; Source, Target: Integer; Integral: Boolean): TPSParam;
var
  Temp: TPSParam;
begin
  Temp := Input;
  case Source of
    5:
      Source := 10;
    11:
      Source := 20;
    17:
      Source := 34
  end;
  Result := Temp;
  if Source = 10 then
  begin
    for var B := 0 to 9 do
    begin
      Result[B * 2] := Temp[B];
      Result[B * 2 + 1] := Temp[B];
    end;
    Source := 20;
    Temp := Result;
  end;
  if (Source = 20) and (Target = 34) then
  begin
    Result[0] := Temp[0];
    Result[1] := (Temp[0] + Temp[1]) / 2;
    Result[2] := Temp[1];
    Result[3] := Temp[2];
    Result[4] := (Temp[2] + Temp[3]) / 2;
    Result[5] := Temp[3];
    Result[6] := Temp[4];
    Result[7] := Temp[4];
    Result[8] := Temp[5];
    Result[9] := Temp[5];
    Result[10] := Temp[6];
    Result[11] := Temp[7];
    Result[12] := Temp[8];
    Result[13] := Temp[8];
    Result[14] := Temp[9];
    Result[15] := Temp[9];
    Result[16] := Temp[10];
    Result[17] := Temp[11];
    Result[18] := Temp[12];
    Result[19] := Temp[13];
    Result[20] := Temp[14];
    Result[21] := Temp[14];
    Result[22] := Temp[15];
    Result[23] := Temp[15];
    Result[24] := Temp[16];
    Result[25] := Temp[16];
    Result[26] := Temp[17];
    Result[27] := Temp[17];
    for var B := 28 to 31 do
      Result[B] := Temp[18];
    Result[32] := Temp[19];
    Result[33] := Temp[19];
  end
  else if (Source = 34) and (Target = 20) then
  begin
    Result[0] := (2 * Temp[0] + Temp[1]) / 3;
    Result[1] := (Temp[1] + 2 * Temp[2]) / 3;
    Result[2] := (2 * Temp[3] + Temp[4]) / 3;
    Result[3] := (Temp[4] + 2 * Temp[5]) / 3;
    Result[4] := (Temp[6] + Temp[7]) / 2;
    Result[5] := (Temp[8] + Temp[9]) / 2;
    Result[6] := Temp[10];
    Result[7] := Temp[11];
    Result[8] := (Temp[12] + Temp[13]) / 2;
    Result[9] := (Temp[14] + Temp[15]) / 2;
    Result[10] := Temp[16];
    Result[11] := Temp[17];
    Result[12] := Temp[18];
    Result[13] := Temp[19];
    for var B := 14 to 17 do
      Result[B] := (Temp[B * 2 - 8] + Temp[B * 2 - 7]) / 2;
    Result[18] := (Temp[28] + Temp[29] + Temp[30] + Temp[31]) / 4;
    Result[19] := (Temp[32] + Temp[33]) / 2;
  end;
  if Integral then
    for var B := 0 to 33 do
      Result[B] := Trunc(Result[B]);
end;

constructor TAACParametricStereo.Create(Slots: Integer);
begin
  inherited Create;
  FSlots := Slots;
  PSRequire(Slots in [30, 32], 'invalid PS time slots');
  FVLC[0].Build(PS_CODES0, PS_BITS0);
  FVLC[1].Build(PS_CODES1, PS_BITS1);
  FVLC[2].Build(PS_CODES2, PS_BITS2);
  FVLC[3].Build(PS_CODES3, PS_BITS3);
  FVLC[4].Build(PS_CODES4, PS_BITS4);
  FVLC[5].Build(PS_CODES5, PS_BITS5);
  FVLC[6].Build(PS_CODES6, PS_BITS6);
  FVLC[7].Build(PS_CODES7, PS_BITS7);
  FVLC[8].Build(PS_CODES8, PS_BITS8);
  FVLC[9].Build(PS_CODES9, PS_BITS9);
  Reset;
end;

procedure TAACParametricStereo.Reset;
begin
  FStarted := False;
  FIID := False;
  FICC := False;
  FExtension := False;
  FPhase := False;
  F34 := False;
  FOld34 := False;
  FEnvelopes := 0;
  FOldEnvelopes := 0;
  FQuant := 0;
  FICCMode := 0;
  FIIDCount := 0;
  FICCCount := 0;
  FPhaseCount := 0;
  FillChar(FBorders, SizeOf(FBorders), 0);
  FillChar(FIIDParams, SizeOf(FIIDParams), 0);
  FillChar(FICCParams, SizeOf(FICCParams), 0);
  FillChar(FIPDParams, SizeOf(FIPDParams), 0);
  FillChar(FOPDParams, SizeOf(FOPDParams), 0);
  FillChar(FInput, SizeOf(FInput), 0);
  FillChar(FDelay, SizeOf(FDelay), 0);
  FillChar(FAllpass, SizeOf(FAllpass), 0);
  FillChar(FPeak, SizeOf(FPeak), 0);
  FillChar(FPower, SizeOf(FPower), 0);
  FillChar(FPeakDiff, SizeOf(FPeakDiff), 0);
  FillChar(FH, SizeOf(FH), 0);
  FillChar(FIPDHistory, SizeOf(FIPDHistory), 0);
  FillChar(FOPDHistory, SizeOf(FOPDHistory), 0);
end;

procedure TAACParametricStereo.ReadParameters(var Bits: TBitReader; var Params: TPSParams; Envelope, Count, Table, Mask, Limit: Integer; Delta: Boolean);
var
  Value, Previous: Integer;
begin
  Previous := Envelope - 1;
  if Envelope = 0 then
    Previous := Max(0, FOldEnvelopes - 1);
  Value := 0;
  for var B := 0 to Count - 1 do
  begin
    if Delta then
      Value := Trunc(Params[Previous, B]);
    Inc(Value, Bits.ReadVLC(FVLC[Table]) + PS_HUFF_OFFSETS[Table]);
    if Mask <> 0 then
      Value := Value and Mask;
    PSRequire((Value >= -Limit) and (Value <= Limit), 'invalid stereo parameter');
    if (Table in [4, 5]) then
      PSRequire(Value >= 0, 'negative coherence');
    Params[Envelope, B] := Value;
  end;
end;

procedure TAACParametricStereo.ReadData(var Bits: TBitReader; BitCount: Integer);
const
  COUNTS: array[0..5] of Integer = (10, 20, 34, 10, 20, 34);
  PHASE_COUNTS: array[0..5] of Integer = (5, 11, 17, 5, 11, 17);
  ENVS: array[0..1, 0..3] of Integer = ((0, 1, 2, 4), (1, 2, 3, 4));
  IID_TABLES: array[0..3] of Integer = (2, 0, 3, 1);
var
  Header, Delta: Boolean;
  Mode, ClassCode, EndBit, ExtensionEnd, Source, Table: Integer;
begin
  EndBit := Bits.Position + BitCount;
  Header := Bits.ReadBit;
  if Header then
  begin
    FIID := Bits.ReadBit;
    if FIID then
    begin
      Mode := Bits.ReadBits(3);
      PSRequire(Mode <= 5, 'reserved IID mode');
      FIIDCount := COUNTS[Mode];
      FQuant := Ord(Mode > 2);
      FPhaseCount := PHASE_COUNTS[Mode];
    end;
    FICC := Bits.ReadBit;
    if FICC then
    begin
      FICCMode := Bits.ReadBits(3);
      PSRequire(FICCMode <= 5, 'reserved ICC mode');
      FICCCount := COUNTS[FICCMode];
    end;
    FExtension := Bits.ReadBit;
  end;
  ClassCode := Bits.ReadBits(1);
  FOldEnvelopes := FEnvelopes;
  FEnvelopes := ENVS[ClassCode, Bits.ReadBits(2)];
  FBorders[0] := -1;
  for var e := 1 to FEnvelopes do
  begin
    if ClassCode = 1 then
      FBorders[e] := Bits.ReadBits(5)
    else
      FBorders[e] := e * FSlots div FEnvelopes - 1;
    PSRequire(FBorders[e] >= FBorders[e - 1], 'nonmonotone envelopes');
  end;
  if FIID then
    for var e := 0 to FEnvelopes - 1 do
    begin
      Delta := Bits.ReadBit;
      Table := IID_TABLES[2 * Ord(Delta) + FQuant];
      ReadParameters(Bits, FIIDParams, e, FIIDCount, Table, 0, 7 + 8 * FQuant, Delta);
    end
  else
    FillChar(FIIDParams, SizeOf(FIIDParams), 0);
  if FICC then
    for var e := 0 to FEnvelopes - 1 do
    begin
      Delta := Bits.ReadBit;
      ReadParameters(Bits, FICCParams, e, FICCCount, 4 + Ord(Delta), 0, 7, Delta);
    end
  else
    FillChar(FICCParams, SizeOf(FICCParams), 0);
  if FExtension then
  begin
    ExtensionEnd := Bits.ReadBits(4);
    if ExtensionEnd = 15 then
      Inc(ExtensionEnd, Bits.ReadBits(8));
    ExtensionEnd := Bits.Position + ExtensionEnd * 8;
    PSRequire(ExtensionEnd <= EndBit, 'extension exceeds payload');
    while ExtensionEnd - Bits.Position > 7 do
    begin
      Mode := Bits.ReadBits(2);
      if Mode = 0 then
      begin
        FPhase := Bits.ReadBit;
        if FPhase then
          for var e := 0 to FEnvelopes - 1 do
          begin
            Delta := Bits.ReadBit;
            ReadParameters(Bits, FIPDParams, e, FPhaseCount, 6 + Ord(Delta), 7, 7, Delta);
            Delta := Bits.ReadBit;
            ReadParameters(Bits, FOPDParams, e, FPhaseCount, 8 + Ord(Delta), 7, 7, Delta);
          end;
        Bits.Skip(1);
      end;
      PSRequire(Bits.Position <= ExtensionEnd, 'phase extension overread');
    end;
    Bits.Skip(ExtensionEnd - Bits.Position);
  end;
  if (FEnvelopes = 0) or (FBorders[FEnvelopes] < FSlots - 1) then
  begin
    Source := FEnvelopes - 1;
    if FEnvelopes = 0 then
      Source := FOldEnvelopes - 1;
    if (Source >= 0) and (Source <> FEnvelopes) then
    begin
      FIIDParams[FEnvelopes] := FIIDParams[Source];
      FICCParams[FEnvelopes] := FICCParams[Source];
      FIPDParams[FEnvelopes] := FIPDParams[Source];
      FOPDParams[FEnvelopes] := FOPDParams[Source];
    end;
    Inc(FEnvelopes);
    FBorders[FEnvelopes] := FSlots - 1;
  end;
  FOld34 := F34;
  if FIID or FICC then
    F34 := (FIID and (FIIDCount = 34)) or (FICC and (FICCCount = 34));
  if not FPhase then
  begin
    FillChar(FIPDParams, SizeOf(FIPDParams), 0);
    FillChar(FOPDParams, SizeOf(FOPDParams), 0);
  end;
  if Header then
    FStarted := True;
  PSRequire(Bits.Position <= EndBit, 'payload overread');
end;

procedure TAACParametricStereo.Analyze(const QMF: TPSQMF);
var
  Filter: TPSFilter;
  Temp: array[0..11] of TPSComplex;
  R, I: Double;
  Bands, First: Integer;
begin
  for var k := 0 to 4 do
    for var n := 0 to FSlots + 5 do
      FInput[k, n + 6] := QMF[n, k];
  FillChar(FLeft, SizeOf(FLeft), 0);
  First := 0;
  for var k := 0 to 4 do
  begin
    if not F34 and (k > 2) then
      Break;
    Filter := Default(TPSFilter);
    if F34 then
    begin
      case k of
        0:
          begin
            Filter := PS_F34_0;
            Bands := 12
          end;
        1:
          begin
            Filter := PS_F34_1;
            Bands := 8
          end;
      else
        Filter := PS_F34_2;
        Bands := 4;
      end;
    end
    else
    begin
      Filter := PS_F20;
      Bands := 8
    end;
    for var n := 0 to FSlots - 1 do
    begin
      if not F34 and (k > 0) then
      begin
        for var Part := 0 to 1 do
        begin
          R := 0;
          I := 0;
          for var j := 0 to 2 do
          begin
            R := R + PS_G1[j * 2 + 1] * (FInput[k, n + j * 2 + 1, 0] + FInput[k, n + 11 - j * 2, 0]);
            I := I + PS_G1[j * 2 + 1] * (FInput[k, n + j * 2 + 1, 1] + FInput[k, n + 11 - j * 2, 1]);
          end;
          var Sign := 1.0;
          if Part <> Ord(k = 1) then
            Sign := -1;
          FLeft[First + Part, n, 0] := FInput[k, n + 6, 0] * 0.5 + Sign * R;
          FLeft[First + Part, n, 1] := FInput[k, n + 6, 1] * 0.5 + Sign * I;
        end;
      end
      else
      begin
        for var Band := 0 to Bands - 1 do
        begin
          R := Filter[Band, 6, 0] * FInput[k, n + 6, 0];
          I := Filter[Band, 6, 0] * FInput[k, n + 6, 1];
          for var j := 0 to 5 do
          begin
            R :=
              R
              + Filter[Band, j, 0] * (FInput[k, n + j, 0] + FInput[k, n + 12 - j, 0])
              - Filter[Band, j, 1] * (FInput[k, n + j, 1] - FInput[k, n + 12 - j, 1]);
            I :=
              I
              + Filter[Band, j, 0] * (FInput[k, n + j, 1] + FInput[k, n + 12 - j, 1])
              + Filter[Band, j, 1] * (FInput[k, n + j, 0] - FInput[k, n + 12 - j, 0]);
          end;
          Temp[Band, 0] := R;
          Temp[Band, 1] := I;
        end;
        if F34 then
          for var Band := 0 to Bands - 1 do
            FLeft[First + Band, n] := Temp[Band]
        else
        begin
          FLeft[0, n] := Temp[6];
          FLeft[1, n] := Temp[7];
          FLeft[2, n] := Temp[0];
          FLeft[3, n] := Temp[1];
          for var z := 0 to 1 do
          begin
            FLeft[4, n, z] := Temp[2, z] + Temp[5, z];
            FLeft[5, n, z] := Temp[3, z] + Temp[4, z];
          end;
        end;
      end;
    end;
    if F34 then
      Inc(First, Bands)
    else if k = 0 then
      Inc(First, 6)
    else
      Inc(First, 2);
  end;
  for var k := 3 + 2 * Ord(F34) to 63 do
    for var n := 0 to FSlots - 1 do
      FLeft[k + 7 + 20 * Ord(F34), n] := QMF[n, k];
  for var k := 0 to 4 do
    Move(FInput[k, FSlots], FInput[k, 0], 6 * SizeOf(TPSComplex));
end;

procedure TAACParametricStereo.Decorrelate;
const
  A: array[0..2] of Double = (0.65143905753106, 0.56471812200776, 0.48954165955695);
var
  Power, Gain: array[0..33, 0..31] of Double;
  Band, Count, AllpassCount, ShortBand, Index: Integer;
  Slope, Denom, R, I, OldR, OldI, Ar, Ai: Double;
  X: TPSComplex;
begin
  Count := 71 + 20 * Ord(F34);
  AllpassCount := 30 + 20 * Ord(F34);
  ShortBand := 42 + 20 * Ord(F34);
  FillChar(Power, SizeOf(Power), 0);
  if F34 <> FOld34 then
  begin
    FillChar(FPeak, SizeOf(FPeak), 0);
    FillChar(FPower, SizeOf(FPower), 0);
    FillChar(FPeakDiff, SizeOf(FPeakDiff), 0);
    FillChar(FDelay, SizeOf(FDelay), 0);
    FillChar(FAllpass, SizeOf(FAllpass), 0);
  end;
  for var k := 0 to Count - 1 do
  begin
    if F34 then
      Band := PS_K34[k]
    else
      Band := PS_K20[k];
    for var n := 0 to FSlots - 1 do
      Power[Band, n] := Power[Band, n] + Sqr(FLeft[k, n, 0]) + Sqr(FLeft[k, n, 1]);
  end;
  for var B := 0 to 19 + 14 * Ord(F34) do
    for var n := 0 to FSlots - 1 do
    begin
      FPeak[B] := Max(0.76592833836465 * FPeak[B], Power[B, n]);
      FPower[B] := FPower[B] + 0.25 * (Power[B, n] - FPower[B]);
      FPeakDiff[B] := FPeakDiff[B] + 0.25 * (FPeak[B] - Power[B, n] - FPeakDiff[B]);
      Denom := 1.5 * FPeakDiff[B];
      Gain[B, n] := 1;
      if Denom > FPower[B] then
        Gain[B, n] := FPower[B] / Denom;
    end;
  for var k := 0 to Count - 1 do
  begin
    if F34 then
      Band := PS_K34[k]
    else
      Band := PS_K20[k];
    Move(FDelay[k, FSlots], FDelay[k, 0], 14 * SizeOf(TPSComplex));
    Move(FLeft[k, 0], FDelay[k, 14], FSlots * SizeOf(TPSComplex));
    if k < AllpassCount then
    begin
      Slope := EnsureRange(1 - 0.05 * (k - 10 - 22 * Ord(F34)), 0.0, 1.0);
      for var m := 0 to 2 do
        Move(FAllpass[k, m, FSlots], FAllpass[k, m, 0], 5 * SizeOf(TPSComplex));
      for var n := 0 to FSlots - 1 do
      begin
        X := CMultiply(FDelay[k, n + 12], PS_PHI[Ord(F34), k]);
        R := X[0];
        I := X[1];
        for var m := 0 to 2 do
        begin
          Ar := A[m] * Slope * R;
          Ai := A[m] * Slope * I;
          OldR := R;
          OldI := I;
          X := CMultiply(FAllpass[k, m, n + 2 - m], PS_Q[Ord(F34), k, m]);
          R := X[0] - Ar;
          I := X[1] - Ai;
          FAllpass[k, m, n + 5, 0] := OldR + A[m] * Slope * R;
          FAllpass[k, m, n + 5, 1] := OldI + A[m] * Slope * I;
        end;
        FRight[k, n, 0] := Gain[Band, n] * R;
        FRight[k, n, 1] := Gain[Band, n] * I;
      end;
    end
    else
    begin
      Index := 13;
      if k < ShortBand then
        Index := 0;
      for var n := 0 to FSlots - 1 do
        for var z := 0 to 1 do
          FRight[k, n, z] := FDelay[k, n + Index, z] * Gain[Band, n];
    end;
  end;
end;

procedure TAACParametricStereo.Mix;
var
  IID, ICC, IPD, OPD: TPSParams;
  Temp: TPSParam;
  Count, Band, Index, Start, Stop, Target: Integer;
  H, Step: array[0..3] of TPSComplex;
  Coefficients: array[0..3] of Double;
  OP, IP, Adjusted, L, R: TPSComplex;
  Width, Sign: Double;

  function Phase(Index: Integer): TPSComplex;
  var
    R, I, M: Double;
  begin
    R := 0.25 * Cos((Index div 64) * Pi / 4) + 0.5 * Cos((Index div 8 mod 8) * Pi / 4) + Cos((Index mod 8) * Pi / 4);
    I := 0.25 * Sin((Index div 64) * Pi / 4) + 0.5 * Sin((Index div 8 mod 8) * Pi / 4) + Sin((Index mod 8) * Pi / 4);
    M := Sqrt(R * R + I * I);
    Result[0] := R / M;
    Result[1] := I / M;
  end;

begin
  Target := 20 + 14 * Ord(F34);
  Count := 71 + 20 * Ord(F34);
  for var B := 0 to 33 do
    for var Tap := 0 to 3 do
      FH[0, B, Tap] := FH[FOldEnvelopes, B, Tap];
  if F34 <> FOld34 then
  begin
    for var Tap := 0 to 3 do
      for var z := 0 to 1 do
      begin
        for var B := 0 to 33 do
          Temp[B] := FH[0, B, Tap, z];
        Temp := Remap(Temp, 54 - Target, Target, False);
        for var B := 0 to 33 do
          FH[0, B, Tap, z] := Temp[B];
      end;
    FillChar(FIPDHistory, SizeOf(FIPDHistory), 0);
    FillChar(FOPDHistory, SizeOf(FOPDHistory), 0);
  end;
  for var e := 0 to FEnvelopes - 1 do
  begin
    IID[e] := Remap(FIIDParams[e], FIIDCount, Target, True);
    ICC[e] := Remap(FICCParams[e], FICCCount, Target, True);
    IPD[e] := Remap(FIPDParams[e], FPhaseCount, Target, True);
    OPD[e] := Remap(FOPDParams[e], FPhaseCount, Target, True);
    for var B := 0 to Target - 1 do
    begin
      Index := Trunc(IID[e, B]) + 7 + 23 * FQuant;
      PSRequire((Index >= 0) and (Index < 46), 'IID outside matrix');
      var Coherence := Trunc(ICC[e, B]);
      PSRequire((Coherence >= 0) and (Coherence <= 7), 'ICC outside matrix');
      for var Tap := 0 to 3 do
        if FICCMode < 3 then
          Coefficients[Tap] := PS_HA[Index, Coherence, Tap]
        else
          Coefficients[Tap] := PS_HB[Index, Coherence, Tap];
      OP[0] := 1;
      OP[1] := 0;
      Adjusted := OP;
      if FPhase and (B < 11 + 6 * Ord(F34)) then
      begin
        Index := FOPDHistory[B] * 8 + Trunc(OPD[e, B]);
        OP := Phase(Index);
        FOPDHistory[B] := Index and 63;
        Index := FIPDHistory[B] * 8 + Trunc(IPD[e, B]);
        IP := Phase(Index);
        FIPDHistory[B] := Index and 63;
        IP[1] := -IP[1];
        Adjusted := CMultiply(OP, IP);
      end;
      for var Tap := 0 to 3 do
        for var z := 0 to 1 do
          if Odd(Tap) then
            FH[e + 1, B, Tap, z] := Coefficients[Tap] * Adjusted[z]
          else
            FH[e + 1, B, Tap, z] := Coefficients[Tap] * OP[z];
    end;
    Start := FBorders[e];
    Stop := FBorders[e + 1];
    Width := 1 / Max(Stop - Start, 1);
    for var k := 0 to Count - 1 do
    begin
      if F34 then
        Band := PS_K34[k]
      else
        Band := PS_K20[k];
      Sign := 1;
      if (F34 and (k >= 9) and (k <= 13)) or (not F34 and (k <= 1)) then
        Sign := -1;
      for var Tap := 0 to 3 do
      begin
        H[Tap] := FH[e, Band, Tap];
        H[Tap, 1] := H[Tap, 1] * Sign;
        for var z := 0 to 1 do
          Step[Tap, z] := (FH[e + 1, Band, Tap, z] - H[Tap, z]) * Width;
      end;
      for var n := Start + 1 to Stop do
      begin
        for var Tap := 0 to 3 do
          for var z := 0 to 1 do
            H[Tap, z] := H[Tap, z] + Step[Tap, z];
        L := FLeft[k, n];
        R := FRight[k, n];
        var A := CMultiply(H[0], L);
        var b := CMultiply(H[2], R);
        var C := CMultiply(H[1], L);
        var D := CMultiply(H[3], R);
        for var z := 0 to 1 do
        begin
          FLeft[k, n, z] := A[z] + b[z];
          FRight[k, n, z] := C[z] + D[z]
        end;
      end;
    end;
  end;
end;

procedure TAACParametricStereo.Synthesize(const Hybrid: TPSHybrid; var QMF: TPSQMF);
var
  First, Count, Bands: Integer;
begin
  if F34 then
    Bands := 5
  else
    Bands := 3;
  First := 0;
  for var k := 0 to Bands - 1 do
  begin
    if F34 then
      case k of
        0:
          Count := 12;
        1:
          Count := 8
      else
        Count := 4
      end
    else if k = 0 then
      Count := 6
    else
      Count := 2;
    for var n := 0 to FSlots - 1 do
      for var z := 0 to 1 do
      begin
        QMF[n, k, z] := 0;
        for var j := 0 to Count - 1 do
          QMF[n, k, z] := QMF[n, k, z] + Hybrid[First + j, n, z];
      end;
    Inc(First, Count);
  end;
  for var k := Bands to 63 do
    for var n := 0 to FSlots - 1 do
      QMF[n, k] := Hybrid[k + 7 + 20 * Ord(F34), n];
end;

procedure TAACParametricStereo.Apply(var Left, Right: TPSQMF; Top: Integer);
var
  Count, AllpassCount: Integer;
begin
  Count := 71 + 20 * Ord(F34);
  AllpassCount := 30 + 20 * Ord(F34);
  Top := EnsureRange(Top + Count - 64, 0, Count);
  for var k := Top to Count - 1 do
  begin
    FillChar(FDelay[k], SizeOf(FDelay[k]), 0);
    if k < AllpassCount then
      FillChar(FAllpass[k], SizeOf(FAllpass[k]), 0);
  end;
  Analyze(Left);
  Decorrelate;
  Mix;
  Synthesize(FLeft, Left);
  Synthesize(FRight, Right);
end;

end.

